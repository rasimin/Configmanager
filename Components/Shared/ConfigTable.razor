@namespace ConfigManager.Components.Shared
@using ConfigManager.Models
@inject IJSRuntime JS

<div class="table-container card">
    <!-- Toolbar: Search, Filter Tabs, View Switcher & Selection Tools -->
    <div class="table-toolbar">
        <div class="toolbar-left">
            <div class="search-input-wrap">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text"
                       class="form-control toolbar-search"
                       placeholder="Filter by file name, path, key, or connection string..."
                       @bind="FilterSearchText"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(FilterSearchText))
                {
                    <button class="clear-search-btn" @onclick="() => FilterSearchText = string.Empty">&times;</button>
                }
            </div>

            <div class="filter-pills">
                <button class="pill-btn @(StatusFilter == null && CategoryFilter == null ? "active" : "")"
                        @onclick="() => { StatusFilter = null; CategoryFilter = null; }">
                    All (@Entries.Count)
                </button>
                @if (Entries.Any(e => e.Category == ConfigCategory.ConnectionStrings))
                {
                    <button class="pill-btn @(CategoryFilter == ConfigCategory.ConnectionStrings ? "active" : "")"
                            @onclick="() => { CategoryFilter = ConfigCategory.ConnectionStrings; StatusFilter = null; }">
                        DB Strings (@Entries.Count(e => e.Category == ConfigCategory.ConnectionStrings))
                    </button>
                }
                @if (Entries.Any(e => e.Category == ConfigCategory.ClientEndpoints))
                {
                    <button class="pill-btn pill-endpoint @(CategoryFilter == ConfigCategory.ClientEndpoints ? "active" : "")"
                            @onclick="() => { CategoryFilter = ConfigCategory.ClientEndpoints; StatusFilter = null; }">
                        Endpoints (@Entries.Count(e => e.Category == ConfigCategory.ClientEndpoints))
                    </button>
                }
                <button class="pill-btn pill-warning @(StatusFilter == ConfigEntryStatus.Modified ? "active" : "")"
                        @onclick="() => { StatusFilter = ConfigEntryStatus.Modified; CategoryFilter = null; }">
                    Modified (@Entries.Count(e => e.Status == ConfigEntryStatus.Modified))
                </button>
                <button class="pill-btn @(StatusFilter == ConfigEntryStatus.Unchanged ? "active" : "")"
                        @onclick="() => { StatusFilter = ConfigEntryStatus.Unchanged; CategoryFilter = null; }">
                    Unchanged (@Entries.Count(e => e.Status == ConfigEntryStatus.Unchanged))
                </button>
                <button class="pill-btn pill-success @(StatusFilter == ConfigEntryStatus.Saved ? "active" : "")"
                        @onclick="() => { StatusFilter = ConfigEntryStatus.Saved; CategoryFilter = null; }">
                    Saved (@Entries.Count(e => e.Status == ConfigEntryStatus.Saved))
                </button>
                @if (Entries.Any(e => e.Status == ConfigEntryStatus.Error))
                {
                    <button class="pill-btn pill-danger @(StatusFilter == ConfigEntryStatus.Error ? "active" : "")"
                            @onclick="() => { StatusFilter = ConfigEntryStatus.Error; CategoryFilter = null; }">
                        Errors (@Entries.Count(e => e.Status == ConfigEntryStatus.Error))
                    </button>
                }
            </div>
        </div>

        <div class="toolbar-right">
            <!-- View Mode Switcher: Stacked Diff (Default) vs Compact Table -->
            <div class="view-mode-toggle">
                <button class="view-toggle-btn @(IsDetailedView ? "active" : "")"
                        @onclick="() => IsDetailedView = true"
                        title="Stacked Diff View: Full application path and stacked Before/After with horizontal scroll">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                    <span>Stacked Diff</span>
                </button>
                <button class="view-toggle-btn @(!IsDetailedView ? "active" : "")"
                        @onclick="() => IsDetailedView = false"
                        title="Compact View: Classic table row overview">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="3" y1="9" x2="21" y2="9"></line>
                        <line x1="3" y1="15" x2="21" y2="15"></line>
                        <line x1="9" y1="3" x2="9" y2="21"></line>
                    </svg>
                    <span>Compact</span>
                </button>
            </div>

            <div class="selection-actions">
                <button class="btn-xs btn-outline" @onclick="SelectAll">Select All</button>
                <button class="btn-xs btn-outline" @onclick="DeselectAll">Deselect All</button>
                <button class="btn-xs btn-outline" @onclick="SelectModifiedOnly">Select Modified</button>
            </div>
        </div>
    </div>

    <!-- Quick Selection Subheader Bar -->
    @if (FilteredEntries.Count > 0)
    {
        <div class="selection-summary-bar">
            <label class="checkbox-label-compact" title="Select or deselect all visible entries">
                <input type="checkbox"
                       checked="@IsAllFilteredSelected"
                       @onchange="ToggleSelectAllFiltered" />
                <span>Select All Visible (@FilteredEntries.Count @(FilteredEntries.Count == 1 ? "setting" : "settings") across @DistinctFilesCount @(DistinctFilesCount == 1 ? "file" : "files"))</span>
            </label>

            <div class="selection-counts">
                <span><strong>@Entries.Count(e => e.IsSelected)</strong> of <strong>@Entries.Count</strong> selected (@DistinctSelectedFilesCount of @DistinctTotalFilesCount files)</span>
                @if (Entries.Any(e => e.Status == ConfigEntryStatus.Modified))
                {
                    <span class="modified-count-pill">• @Entries.Count(e => e.Status == ConfigEntryStatus.Modified) pending save</span>
                }
            </div>
        </div>
    }

    <!-- Content Scroll Wrap -->
    <div class="table-scroll-wrap">
        @if (FilteredEntries.Count == 0)
        {
            <div class="empty-state">
                @if (Entries.Count == 0)
                {
                    <div class="empty-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <h4>No Configuration Files Loaded Yet</h4>
                    <p>Enter a folder path above and click <strong>"Scan / Refresh"</strong> or use <strong>"Browse Folder / File"</strong> to load targets.</p>
                }
                else
                {
                    <div class="empty-icon">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>
                    <h4>No Matching Entries</h4>
                    <p>No records match the current filter criteria: "<strong>@FilterSearchText</strong>".</p>
                    <button class="btn btn-secondary btn-sm" @onclick="ClearFilters">Clear Filters</button>
                }
            </div>
        }
        else if (IsDetailedView)
        {
            <!-- ==============================================================
                 GROUPED STACKED DIFF CARD VIEW (DEFAULT):
                 - Grouped by File: 1 Card per file, no duplicate headers/paths
                 - Full Application Path clearly visible once at the file top
                 - Nested setting items with Before & After horizontal scroll
                 ============================================================== -->
            <div class="file-group-list">
                @foreach (var fileGroup in GroupedEntries)
                {
                    var firstEntry = fileGroup.First();
                    var isXml = firstEntry.FileType == ConfigFileType.WebConfig;
                    var groupStatus = GetGroupStatus(fileGroup);
                    var isGroupModified = groupStatus == ConfigEntryStatus.Modified;
                    var isGroupSaved = groupStatus == ConfigEntryStatus.Saved;
                    var isAllSelected = fileGroup.All(e => e.IsSelected);
                    var isGroupActive = fileGroup.Any(e => ActiveEntry?.Id == e.Id);

                    <div class="file-group-card @(isGroupActive ? "group-active" : "") @(isGroupModified ? "group-modified" : "") @(isGroupSaved ? "group-saved" : "")">
                        <!-- Group Header: Master File Checkbox, File Name, Badges, Explorer & Revert -->
                        <div class="file-group-header">
                            <div class="file-header-left">
                                <label class="card-checkbox-label" title="Select/Deselect all settings in this file" @onclick:stopPropagation="true">
                                    <input type="checkbox"
                                           checked="@isAllSelected"
                                           @onchange="(e) => ToggleFileSelection(fileGroup.Key, (bool?)e.Value ?? false)" />
                                </label>

                                <div class="file-title-block">
                                    <span class="file-icon-wrap">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                        </svg>
                                    </span>
                                    <span class="file-name-text">@firstEntry.FileName</span>

                                    <span class="type-pill @(isXml ? "type-xml" : "type-json")">
                                        @(isXml ? "XML web.config" : "JSON appsettings")
                                    </span>

                                    <span class="item-count-badge" title="@fileGroup.Count() configurable setting(s) in this file">
                                        @fileGroup.Count() @(fileGroup.Count() == 1 ? "setting" : "settings")
                                    </span>
                                </div>
                            </div>

                            <div class="file-header-right" @onclick:stopPropagation="true">
                                <button class="btn-subtle-action"
                                        @onclick="() => OnOpenFolder.InvokeAsync(firstEntry.FilePath)"
                                        title="Open containing folder in Windows Explorer">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                        <polyline points="15 3 21 3 21 9"></polyline>
                                        <line x1="10" y1="14" x2="21" y2="3"></line>
                                    </svg>
                                    <span>Explorer</span>
                                </button>

                                <StatusBadge Status="@groupStatus" />

                                @if (fileGroup.Any(e => !string.IsNullOrEmpty(e.BackupPath)))
                                {
                                    var bak = fileGroup.FirstOrDefault(e => !string.IsNullOrEmpty(e.BackupPath))?.BackupPath;
                                    <span class="backup-pill" title="Backup created: @bak">
                                        Bak: @System.IO.Path.GetFileName(bak)
                                    </span>
                                }

                                @if (isGroupModified)
                                {
                                    <button class="btn-action-icon btn-revert"
                                            @onclick="() => RevertAllInFile(fileGroup)"
                                            title="Revert all modified settings in this file">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="1 4 1 10 7 10"></polyline>
                                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                        </svg>
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Single Full Application File Path Row -->
                        <div class="file-path-bar">
                            <svg class="path-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span class="path-text" title="@firstEntry.FilePath">@firstEntry.FilePath</span>
                            <button class="btn-copy-inline"
                                    @onclick="() => CopyText(firstEntry.FilePath)"
                                    @onclick:stopPropagation="true"
                                    title="Copy full file path">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                </svg>
                                <span>Copy Path</span>
                            </button>
                        </div>

                        <!-- Nested Entries for this File -->
                        <div class="file-group-items">
                            @foreach (var entry in fileGroup)
                            {
                                var isEntryModified = entry.Status == ConfigEntryStatus.Modified;
                                var isItemActive = ActiveEntry?.Id == entry.Id;

                                <div class="file-entry-item @(entry.IsSelected ? "item-selected" : "") @(isEntryModified ? "item-modified" : "") @(isItemActive ? "item-active" : "")"
                                     @onclick="() => OnRowSelected.InvokeAsync(entry)">
                                    
                                    <!-- Item Header: Individual Checkbox, Key / Endpoint info, Provider & Actions -->
                                    <div class="item-header">
                                        <div class="item-header-left">
                                            <label class="card-checkbox-label" @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                       @bind="entry.IsSelected"
                                                       @bind:after="NotifySelectionChange" />
                                            </label>

                                            @if (entry.Category == ConfigCategory.ClientEndpoints)
                                            {
                                                <span class="type-pill type-endpoint" title="@(entry.FileType == ConfigFileType.AppSettingsJson ? "JSON Service Endpoint" : "WCF Client Endpoint")">
                                                    @(entry.FileType == ConfigFileType.AppSettingsJson ? "Service Endpoint" : "WCF Endpoint")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="type-pill type-db" title="Database Connection String">
                                                    DB Connection
                                                </span>
                                            }

                                            <span class="key-pill" title="@(entry.Category == ConfigCategory.ClientEndpoints ? "Endpoint Name / Contract" : "Connection String Key Name")">
                                                <span class="key-label">@(entry.Category == ConfigCategory.ClientEndpoints ? "Endpoint:" : "Key:")</span> @entry.KeyName
                                            </span>

                                            @if (!string.IsNullOrEmpty(entry.ProviderName))
                                            {
                                                <span class="provider-pill" title="Binding/Provider: @entry.ProviderName">
                                                    @entry.ProviderName
                                                </span>
                                            }
                                        </div>

                                        <div class="item-header-right" @onclick:stopPropagation="true">
                                            <StatusBadge Status="@entry.Status" ErrorMessage="@entry.ErrorMessage" />

                                            <div class="card-action-btns">
                                                <button class="btn-action-icon"
                                                        @onclick="() => OnInspectEntry.InvokeAsync(entry)"
                                                        title="Inspect &amp; Compare Diff Details">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="11" cy="11" r="8"></circle>
                                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                    </svg>
                                                </button>

                                                @if (entry.Status == ConfigEntryStatus.Modified)
                                                {
                                                    <button class="btn-action-icon btn-revert"
                                                            @onclick="() => OnRevertEntry.InvokeAsync(entry)"
                                                            title="Revert this setting to original">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <polyline points="1 4 1 10 7 10"></polyline>
                                                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Stacked Before & After Diff Box for this setting -->
                                    <div class="entry-diff-box">
                                        <!-- BEFORE / CURRENT -->
                                        <div class="diff-row diff-before-row">
                                            <span class="diff-badge badge-before">BEFORE</span>
                                            <div class="diff-scroll-code">
                                                <code class="mono-code">@entry.CurrentValue</code>
                                            </div>
                                            <button class="btn-diff-copy"
                                                    @onclick="() => CopyText(entry.CurrentValue)"
                                                    @onclick:stopPropagation="true"
                                                    title="Copy original value">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                                </svg>
                                                <span>Copy</span>
                                            </button>
                                        </div>

                                        <!-- AFTER / PREVIEW -->
                                        <div class="diff-row diff-after-row @(isEntryModified ? "modified-highlight" : "")">
                                            <span class="diff-badge badge-after @(isEntryModified ? "badge-amber" : "")">
                                                @(isEntryModified ? "AFTER" : "PREVIEW")
                                            </span>

                                            @if (entry.IsInlineEditing)
                                            {
                                                <div class="diff-inline-edit" @onclick:stopPropagation="true">
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           @bind="entry.NewValue" />
                                                    <div class="inline-edit-actions">
                                                        <button class="btn-xs btn-primary" @onclick="() => SaveInlineEdit(entry)">Done</button>
                                                        <button class="btn-xs btn-secondary" @onclick="() => CancelInlineEdit(entry)">Cancel</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="diff-scroll-code @(isEntryModified ? "code-modified" : "")">
                                                    <code class="mono-code">@entry.NewValue</code>
                                                </div>
                                                <div class="diff-after-actions" @onclick:stopPropagation="true">
                                                    <button class="btn-diff-copy"
                                                            @onclick="() => CopyText(entry.NewValue)"
                                                            title="Copy preview value">
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                                        </svg>
                                                        <span>Copy</span>
                                                    </button>
                                                    <button class="btn-diff-edit"
                                                            @onclick="() => StartInlineEdit(entry)"
                                                            title="Inline edit this preview value">
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M12 20h9"></path>
                                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                        </svg>
                                                        <span>Edit</span>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                </div>
                            }
                        </div>

                    </div>
                }
            </div>
        }
        else
        {
            <!-- ==============================================================
                 COMPACT TABLE VIEW (GROUPED BY FILE)
                 ============================================================== -->
            <table class="config-table">
                <thead>
                    <tr>
                        <th class="th-checkbox">
                            <input type="checkbox"
                                   checked="@IsAllFilteredSelected"
                                   @onchange="ToggleSelectAllFiltered"
                                   title="Select or deselect all visible rows" />
                        </th>
                        <th class="th-file">Setting / Key</th>
                        <th class="th-type">Type</th>
                        <th class="th-key">Key Name</th>
                        <th class="th-current">Current Value</th>
                        <th class="th-preview">Preview New Value</th>
                        <th class="th-status">Status</th>
                        <th class="th-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fileGroup in GroupedEntries)
                    {
                        var firstEntry = fileGroup.First();
                        var isAllSelected = fileGroup.All(e => e.IsSelected);
                        var groupStatus = GetGroupStatus(fileGroup);

                        <tr class="table-group-header-row">
                            <td class="td-checkbox" @onclick:stopPropagation="true">
                                <input type="checkbox"
                                       checked="@isAllSelected"
                                       @onchange="(e) => ToggleFileSelection(fileGroup.Key, (bool?)e.Value ?? false)"
                                       title="Select all settings in this file" />
                            </td>
                            <td colspan="7" class="td-group-header">
                                <div class="group-header-content">
                                    <span class="file-group-name">📄 @firstEntry.FileName</span>
                                    <span class="file-group-badge">@fileGroup.Count() @(fileGroup.Count() == 1 ? "setting" : "settings")</span>
                                    <span class="file-group-path" title="@firstEntry.FilePath">@firstEntry.FilePath</span>
                                    <button class="btn-icon-subtle"
                                            @onclick="() => OnOpenFolder.InvokeAsync(firstEntry.FilePath)"
                                            title="Open containing folder in Windows Explorer">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                            <polyline points="15 3 21 3 21 9"></polyline>
                                            <line x1="10" y1="14" x2="21" y2="3"></line>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        @foreach (var entry in fileGroup)
                        {
                            var isXml = entry.FileType == ConfigFileType.WebConfig;
                            var isModified = entry.Status == ConfigEntryStatus.Modified;
                            var isSaved = entry.Status == ConfigEntryStatus.Saved;

                            <tr class="table-row @(entry.IsSelected ? "row-selected" : "") @(isModified ? "row-modified" : "") @(isSaved ? "row-saved" : "") @(ActiveEntry?.Id == entry.Id ? "row-active" : "")"
                                @onclick="() => OnRowSelected.InvokeAsync(entry)">
                                <td class="td-checkbox" @onclick:stopPropagation="true">
                                    <input type="checkbox"
                                           @bind="entry.IsSelected"
                                           @bind:after="NotifySelectionChange" />
                                </td>

                                <td class="td-file">
                                    <span class="file-sub-item">↳ @entry.KeyName</span>
                                </td>

                                <td class="td-type">
                                    @if (entry.Category == ConfigCategory.ClientEndpoints)
                                    {
                                        <span class="type-pill type-endpoint">@(entry.FileType == ConfigFileType.AppSettingsJson ? "Service Endpoint" : "WCF Endpoint")</span>
                                    }
                                    else
                                    {
                                        <span class="type-pill type-db">DB String</span>
                                    }
                                    @if (!string.IsNullOrEmpty(entry.ProviderName))
                                    {
                                        <div class="provider-info" title="Provider/Binding: @entry.ProviderName">@entry.ProviderName</div>
                                    }
                                </td>

                                <td class="td-key">
                                    <span class="key-pill" title="@entry.KeyName">@entry.KeyName</span>
                                </td>

                                <td class="td-current">
                                    <div class="code-cell">
                                        <span class="code-snippet" title="@entry.CurrentValue">@entry.CurrentValue</span>
                                        <button class="btn-copy" @onclick="() => CopyText(entry.CurrentValue)" title="Copy Current Value">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </td>

                                <td class="td-preview">
                                    @if (entry.IsInlineEditing)
                                    {
                                        <div class="inline-edit-box">
                                            <input type="text"
                                                   class="form-control form-control-sm"
                                                   @bind="entry.NewValue" />
                                            <div class="inline-edit-buttons">
                                                <button class="btn-xs btn-primary"
                                                        @onclick="() => SaveInlineEdit(entry)"
                                                        title="Set New Value">
                                                    Done
                                                </button>
                                                <button class="btn-xs btn-secondary"
                                                        @onclick="() => CancelInlineEdit(entry)"
                                                        title="Cancel">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="preview-cell @(isModified ? "preview-modified" : "")"
                                             @onclick="() => StartInlineEdit(entry)"
                                             title="Click to inline edit">
                                            <span class="code-snippet">@entry.NewValue</span>
                                            <button class="btn-pencil" title="Inline Edit">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M12 20h9"></path>
                                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    }
                                </td>

                                <td class="td-status">
                                    <StatusBadge Status="@entry.Status" ErrorMessage="@entry.ErrorMessage" />
                                    @if (!string.IsNullOrEmpty(entry.BackupPath))
                                    {
                                        <div class="backup-note" title="Backup created: @entry.BackupPath">
                                            Bak: @System.IO.Path.GetFileName(entry.BackupPath)
                                        </div>
                                    }
                                </td>

                                <td class="td-actions">
                                    <div class="action-btn-group">
                                        <button class="btn-action-icon"
                                                @onclick="() => OnInspectEntry.InvokeAsync(entry)"
                                                title="Inspect &amp; Compare Diff">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="11" cy="11" r="8"></circle>
                                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            </svg>
                                        </button>

                                        @if (entry.Status == ConfigEntryStatus.Modified)
                                        {
                                            <button class="btn-action-icon btn-revert"
                                                    @onclick="() => OnRevertEntry.InvokeAsync(entry)"
                                                    title="Revert this entry to original">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="1 4 1 10 7 10"></polyline>
                                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    [Parameter] public List<ConnectionStringEntry> Entries { get; set; } = new();
    [Parameter] public ConnectionStringEntry? ActiveEntry { get; set; }
    [Parameter] public EventCallback<ConnectionStringEntry> OnRowSelected { get; set; }
    [Parameter] public EventCallback<ConnectionStringEntry> OnInspectEntry { get; set; }
    [Parameter] public EventCallback<ConnectionStringEntry> OnRevertEntry { get; set; }
    [Parameter] public EventCallback<string> OnOpenFolder { get; set; }
    [Parameter] public EventCallback OnSelectionChanged { get; set; }

    // Default to Stacked Detailed View as requested by the user
    private bool IsDetailedView { get; set; } = true;
    private string FilterSearchText { get; set; } = string.Empty;
    private ConfigEntryStatus? StatusFilter { get; set; }
    private ConfigCategory? CategoryFilter { get; set; }

    private List<ConnectionStringEntry> FilteredEntries
    {
        get
        {
            var query = Entries.AsEnumerable();

            if (CategoryFilter.HasValue)
            {
                query = query.Where(e => e.Category == CategoryFilter.Value);
            }

            if (StatusFilter.HasValue)
            {
                query = query.Where(e => e.Status == StatusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(FilterSearchText))
            {
                var txt = FilterSearchText.Trim();
                query = query.Where(e =>
                    e.FileName.Contains(txt, StringComparison.OrdinalIgnoreCase) ||
                    e.FilePath.Contains(txt, StringComparison.OrdinalIgnoreCase) ||
                    e.DirectoryPath.Contains(txt, StringComparison.OrdinalIgnoreCase) ||
                    e.KeyName.Contains(txt, StringComparison.OrdinalIgnoreCase) ||
                    e.CurrentValue.Contains(txt, StringComparison.OrdinalIgnoreCase) ||
                    e.NewValue.Contains(txt, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private IEnumerable<IGrouping<string, ConnectionStringEntry>> GroupedEntries =>
        FilteredEntries.GroupBy(e => e.FilePath, StringComparer.OrdinalIgnoreCase);

    private int DistinctFilesCount =>
        FilteredEntries.Select(e => e.FilePath).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    private int DistinctSelectedFilesCount =>
        Entries.Where(e => e.IsSelected).Select(e => e.FilePath).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    private int DistinctTotalFilesCount =>
        Entries.Select(e => e.FilePath).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    private ConfigEntryStatus GetGroupStatus(IEnumerable<ConnectionStringEntry> group)
    {
        var list = group.ToList();
        if (list.Any(e => e.Status == ConfigEntryStatus.Error)) return ConfigEntryStatus.Error;
        if (list.Any(e => e.Status == ConfigEntryStatus.Modified)) return ConfigEntryStatus.Modified;
        if (list.All(e => e.Status == ConfigEntryStatus.Saved)) return ConfigEntryStatus.Saved;
        return ConfigEntryStatus.Unchanged;
    }

    private async Task ToggleFileSelection(string filePath, bool isChecked)
    {
        foreach (var entry in FilteredEntries.Where(e => string.Equals(e.FilePath, filePath, StringComparison.OrdinalIgnoreCase)))
        {
            entry.IsSelected = isChecked;
        }
        await NotifySelectionChange();
    }

    private async Task RevertAllInFile(IEnumerable<ConnectionStringEntry> entries)
    {
        foreach (var entry in entries.Where(e => e.Status == ConfigEntryStatus.Modified).ToList())
        {
            await OnRevertEntry.InvokeAsync(entry);
        }
    }

    private bool IsAllFilteredSelected =>
        FilteredEntries.Count > 0 && FilteredEntries.All(e => e.IsSelected);

    private async Task ToggleSelectAllFiltered(ChangeEventArgs e)
    {
        var isChecked = (bool?)e.Value ?? false;
        foreach (var entry in FilteredEntries)
        {
            entry.IsSelected = isChecked;
        }
        await NotifySelectionChange();
    }

    private async Task SelectAll()
    {
        foreach (var entry in Entries) entry.IsSelected = true;
        await NotifySelectionChange();
    }

    private async Task DeselectAll()
    {
        foreach (var entry in Entries) entry.IsSelected = false;
        await NotifySelectionChange();
    }

    private async Task SelectModifiedOnly()
    {
        foreach (var entry in Entries)
        {
            entry.IsSelected = entry.Status == ConfigEntryStatus.Modified;
        }
        await NotifySelectionChange();
    }

    private void ClearFilters()
    {
        FilterSearchText = string.Empty;
        StatusFilter = null;
    }

    private void StartInlineEdit(ConnectionStringEntry entry)
    {
        entry.IsInlineEditing = true;
    }

    private void SaveInlineEdit(ConnectionStringEntry entry)
    {
        entry.IsInlineEditing = false;
        entry.ApplyPreview(entry.NewValue);
    }

    private void CancelInlineEdit(ConnectionStringEntry entry)
    {
        entry.IsInlineEditing = false;
        entry.NewValue = entry.HasChanges ? entry.NewValue : entry.CurrentValue;
    }

    private async Task NotifySelectionChange()
    {
        await OnSelectionChanged.InvokeAsync();
    }

    private async Task CopyText(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch { }
    }
}
