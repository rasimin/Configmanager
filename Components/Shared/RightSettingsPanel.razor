@namespace ConfigManager.Components.Shared
@using ConfigManager.Models

<div class="settings-panel card">
    <!-- Category Tabs Navigation -->
    <div class="category-header">
        <div class="category-tabs">
            <button class="cat-tab @(ActiveCategory == ConfigCategory.ConnectionStrings ? "active" : "")"
                    @onclick="() => ActiveCategory = ConfigCategory.ConnectionStrings">
                <span>Connection Strings</span>
                @if (ActiveCategory == ConfigCategory.ConnectionStrings)
                {
                    <div class="tab-indicator"></div>
                }
            </button>
            <button class="cat-tab @(ActiveCategory == ConfigCategory.ClientEndpoints ? "active" : "")"
                    @onclick="() => ActiveCategory = ConfigCategory.ClientEndpoints">
                <span>Client Endpoints</span>
                @if (ActiveCategory == ConfigCategory.ClientEndpoints)
                {
                    <div class="tab-indicator"></div>
                }
            </button>
            <button class="cat-tab @(ActiveCategory == ConfigCategory.AppSettings ? "active" : "")"
                    @onclick="() => ActiveCategory = ConfigCategory.AppSettings">
                <span>App Settings</span>
                <span class="cat-soon-badge">Soon</span>
            </button>
            <button class="cat-tab @(ActiveCategory == ConfigCategory.EnvironmentVariables ? "active" : "")"
                    @onclick="() => ActiveCategory = ConfigCategory.EnvironmentVariables">
                <span>Env Vars</span>
                <span class="cat-soon-badge">Soon</span>
            </button>
        </div>
    </div>

    <!-- Category Content -->
    @if (ActiveCategory == ConfigCategory.ConnectionStrings)
    {
        <div class="panel-scroll-content">
            <!-- Mode Switcher: Structured Parameters vs Raw Find/Replace -->
            <div class="submode-segment">
                <button class="segment-btn @(EditMode == "structured" ? "active" : "")"
                        @onclick='() => EditMode = "structured"'>
                    Parameters (Host, DB, User)
                </button>
                <button class="segment-btn @(EditMode == "raw" ? "active" : "")"
                        @onclick='() => EditMode = "raw"'>
                    Raw Find &amp; Replace
                </button>
            </div>

            @if (EditMode == "structured")
            {
                <!-- Structured Fields Form -->
                <div class="bulk-form-box">
                    <div class="form-header-group">
                        <div class="form-title">BULK PARAMETER OVERRIDES</div>
                        <div class="form-subtitle">Blank fields remain untouched • Live preview on left</div>
                    </div>

                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label">Host / Server</label>
                            @if (!string.IsNullOrWhiteSpace(StructuredArgs.Server) && ActiveEntry != null)
                            {
                                var currentHost = ConnectionStringHelper.Parse(ActiveEntry.CurrentValue).Server ?? "old";
                                <span class="form-label-hint mono">@currentHost &rarr; @StructuredArgs.Server</span>
                            }
                        </div>
                        <div class="input-with-indicator">
                            <input type="text"
                                   class="form-input mono"
                                   placeholder="e.g. 192.168.26.21"
                                   @bind="StructuredArgs.Server"
                                   @bind:event="oninput" />
                            @if (!string.IsNullOrWhiteSpace(StructuredArgs.Server))
                            {
                                <span class="input-green-dot"></span>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Database</label>
                        <input type="text"
                               class="form-input mono"
                               placeholder="e.g. SalesDatabase_Prod"
                               @bind="StructuredArgs.Database" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Username</label>
                        <input type="text"
                               class="form-input mono"
                               placeholder="e.g. sa"
                               @bind="StructuredArgs.UserId" />
                    </div>

                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label">Password</label>
                            <button type="button" class="btn-text-action" @onclick="() => ShowPassword = !ShowPassword">
                                @(ShowPassword ? "Hide" : "Show")
                            </button>
                        </div>
                        <div class="input-with-action">
                            <input type="@(ShowPassword ? "text" : "password")"
                                   class="form-input mono"
                                   placeholder="•••••"
                                   @bind="StructuredArgs.Password" />
                            <button type="button" class="btn-input-icon" @onclick="() => ShowPassword = !ShowPassword" title="Toggle visibility">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Optional Client Endpoints Update Section -->
                    <div class="endpoint-option-card">
                        <div class="endpoint-option-top">
                            <label class="endpoint-checkbox-label">
                                <input type="checkbox" class="checkbox-custom" @bind="StructuredArgs.UpdateEndpoints" />
                                <span class="endpoint-label-title">Update Client Endpoints (Optional)</span>
                            </label>
                            <div class="endpoint-badges">
                                <span class="sub-badge">WCF</span>
                                <span class="sub-badge">SSO</span>
                            </div>
                        </div>
                        <div class="endpoint-option-desc">
                            Rewrites endpoint addresses to new host automatically.
                        </div>

                        @if (StructuredArgs.UpdateEndpoints)
                        {
                            <div class="endpoint-subform-box">
                                <div class="form-group">
                                    <label class="form-label-xs">Find in Endpoint URL</label>
                                    <input type="text"
                                           class="form-input-sm mono"
                                           placeholder="e.g. localhost or 192.168.43.164"
                                           @bind="StructuredArgs.EndpointFindPattern" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label-xs">Replace with</label>
                                    <input type="text"
                                           class="form-input-sm mono"
                                           placeholder="e.g. 192.168.26.21"
                                           @bind="StructuredArgs.EndpointReplacePattern" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label-xs">Specific Full URL (Optional)</label>
                                    <input type="text"
                                           class="form-input-sm mono"
                                           placeholder="e.g. http://192.168.26.21/VICTOR/SSO/Service/SSO.asmx"
                                           @bind="StructuredArgs.EndpointNewAddress" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label-xs">Target Endpoint Name (Optional)</label>
                                    <input type="text"
                                           class="form-input-sm mono"
                                           placeholder="e.g. SSOSoap (or blank for all)"
                                           @bind="StructuredArgs.TargetEndpointName" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="form-actions-group">
                        <button class="btn-pill-dark btn-apply-full"
                                @onclick="ApplyStructuredToSelected"
                                disabled="@(IsStructuredEmpty || SelectedCount == 0)">
                            Apply to @SelectedCount Selected
                        </button>

                        <button class="btn-pill-subtle btn-clear"
                                @onclick="ClearStructuredFields"
                                title="Clear form fields">
                            Clear
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Raw Find & Replace Form -->
                <div class="bulk-form-box">
                    <div class="form-header-group">
                        <div class="form-title">GLOBAL FIND &amp; REPLACE</div>
                        <div class="form-subtitle">Search and replace arbitrary strings in selected records</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Find Text</label>
                        <input type="text"
                               class="form-input mono"
                               placeholder="Exact string to find..."
                               @bind="RawFindText" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Replace With</label>
                        <input type="text"
                               class="form-input mono"
                               placeholder="Replacement string..."
                               @bind="RawReplaceWith" />
                    </div>

                    <div class="form-group">
                        <label class="endpoint-checkbox-label">
                            <input type="checkbox" class="checkbox-custom" @bind="MatchCase" />
                            <span class="endpoint-label-title">Match Case (Case sensitive)</span>
                        </label>
                    </div>

                    <div class="form-actions-group">
                        <button class="btn-pill-dark btn-apply-full"
                                @onclick="ApplyRawToSelected"
                                disabled="@(string.IsNullOrEmpty(RawFindText) || SelectedCount == 0)">
                            Apply Preview to @SelectedCount Selected
                        </button>
                    </div>
                </div>
            }

            <!-- Active Row Inspector Card -->
            <div class="inspector-section">
                <div class="inspector-header">
                    <span class="inspector-title">ACTIVE ROW INSPECTOR</span>
                    @if (ActiveEntry != null)
                    {
                        <button class="btn-link-inspector" @onclick="() => OnInspectModal.InvokeAsync(ActiveEntry)">
                            Open Full Diff ↗
                        </button>
                    }
                </div>

                @if (ActiveEntry == null)
                {
                    <div class="inspector-empty-text">Select any row in the table to inspect details</div>
                }
                else
                {
                    var isConn = ActiveEntry.Category == ConfigCategory.ConnectionStrings;
                    var parsed = isConn ? ConnectionStringHelper.Parse(ActiveEntry.CurrentValue) : null;

                    <div class="inspector-specs-table">
                        <div class="spec-row">
                            <span class="spec-label">Category</span>
                            <span class="spec-value">@(isConn ? "Database" : "Endpoint")</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">File</span>
                            <span class="spec-value mono" title="@ActiveEntry.FileName">@ActiveEntry.FileName</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">Key</span>
                            <span class="spec-value mono font-medium">@ActiveEntry.KeyName</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">Type</span>
                            <span class="spec-value mono text-muted">
                                @(string.IsNullOrEmpty(ActiveEntry.ProviderName) ? (ActiveEntry.FileType == ConfigFileType.WebConfig ? "web.config" : "appsettings.json") : ActiveEntry.ProviderName)
                            </span>
                        </div>
                        @if (isConn && parsed != null)
                        {
                            <div class="spec-row">
                                <span class="spec-label">Host</span>
                                <span class="spec-value mono">@(parsed.Server ?? "-")</span>
                            </div>
                            <div class="spec-row">
                                <span class="spec-label">Database</span>
                                <span class="spec-value mono">@(parsed.Database ?? "-")</span>
                            </div>
                        }
                        else
                        {
                            <div class="spec-row">
                                <span class="spec-label">Address</span>
                                <span class="spec-value mono truncate" title="@ActiveEntry.CurrentValue">@ActiveEntry.CurrentValue</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Sticky Save Dock at the bottom -->
        <div class="save-dock-bottom">
            <div class="dock-status-info">
                <span class="dock-amber-dot"></span>
                <span class="dock-status-text">
                    Pending saves: <strong>@ModifiedCount</strong> &bull; Auto-backup enabled
                </span>
            </div>
            <button class="btn-save-emerald"
                    @onclick="() => OnSaveAllClicked.InvokeAsync()"
                    disabled="@(ModifiedCount == 0 || IsSaving)">
                @if (IsSaving)
                {
                    <span class="spinner-small-light"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save All Changes (@ModifiedCount)</span>
                }
            </button>
        </div>
    }
    else if (ActiveCategory == ConfigCategory.ClientEndpoints)
    {
        <div class="panel-scroll-content">
            <div class="bulk-form-box">
                <div class="form-header-group">
                    <div class="form-title">WCF &amp; CLIENT ENDPOINTS</div>
                    <div class="form-subtitle">Direct endpoint rewriting for client bindings</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Find in URL</label>
                    <input type="text"
                           class="form-input mono"
                           placeholder="e.g. localhost or 192.168.43.164"
                           @bind="EndpointOnlyFind" />
                </div>

                <div class="form-group">
                    <label class="form-label">Replace with</label>
                    <input type="text"
                           class="form-input mono"
                           placeholder="e.g. 192.168.26.21"
                           @bind="EndpointOnlyReplace" />
                </div>

                <div class="form-group">
                    <label class="form-label">Specific Full URL (Optional)</label>
                    <input type="text"
                           class="form-input mono"
                           placeholder="e.g. http://192.168.26.21/VICTOR/SSO/Service/SSO.asmx"
                           @bind="EndpointOnlyDirectUrl" />
                </div>

                <div class="form-group">
                    <label class="form-label">Target Endpoint Name (Optional)</label>
                    <input type="text"
                           class="form-input mono"
                           placeholder="e.g. SSOSoap (or blank for all)"
                           @bind="EndpointOnlyTargetName" />
                </div>

                <div class="form-actions-group">
                    <button class="btn-pill-dark btn-apply-full"
                            @onclick="ApplyEndpointOnly"
                            disabled="@((string.IsNullOrWhiteSpace(EndpointOnlyFind) && string.IsNullOrWhiteSpace(EndpointOnlyDirectUrl)) || SelectedCount == 0)">
                        Apply to @SelectedCount Selected
                    </button>
                    <button class="btn-pill-subtle btn-clear"
                            @onclick="ClearEndpointOnly">
                        Clear
                    </button>
                </div>
            </div>

            <!-- Active Row Inspector for Endpoint -->
            @if (ActiveEntry != null)
            {
                <div class="inspector-section">
                    <div class="inspector-header">
                        <span class="inspector-title">ACTIVE ROW INSPECTOR</span>
                        <button class="btn-link-inspector" @onclick="() => OnInspectModal.InvokeAsync(ActiveEntry)">
                            Open Full Diff ↗
                        </button>
                    </div>
                    <div class="inspector-specs-table">
                        <div class="spec-row">
                            <span class="spec-label">Category</span>
                            <span class="spec-value">Client Endpoint</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">Name</span>
                            <span class="spec-value mono">@ActiveEntry.KeyName</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-label">File</span>
                            <span class="spec-value mono">@ActiveEntry.FileName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(ActiveEntry.ProviderName))
                        {
                            <div class="spec-row">
                                <span class="spec-label">Binding</span>
                                <span class="spec-value mono">@ActiveEntry.ProviderName</span>
                            </div>
                        }
                        <div class="spec-row">
                            <span class="spec-label">Address</span>
                            <span class="spec-value mono truncate" title="@ActiveEntry.CurrentValue">@ActiveEntry.CurrentValue</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="save-dock-bottom">
            <div class="dock-status-info">
                <span class="dock-amber-dot"></span>
                <span class="dock-status-text">
                    Pending saves: <strong>@ModifiedCount</strong> &bull; Auto-backup enabled
                </span>
            </div>
            <button class="btn-save-emerald"
                    @onclick="() => OnSaveAllClicked.InvokeAsync()"
                    disabled="@(ModifiedCount == 0 || IsSaving)">
                @if (IsSaving)
                {
                    <span class="spinner-small-light"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save All Changes (@ModifiedCount)</span>
                }
            </button>
        </div>
    }
    else if (ActiveCategory == ConfigCategory.AppSettings)
    {
        <div class="panel-scroll-content empty-category-panel">
            <div class="empty-cat-icon">⚙️</div>
            <h4>App Settings Category</h4>
            <p>Future modular configuration category for key-value app settings and JSON nodes.</p>
        </div>
    }
    else
    {
        <div class="panel-scroll-content empty-category-panel">
            <div class="empty-cat-icon">🌐</div>
            <h4>Environment Variables Category</h4>
            <p>Future modular configuration category for container and runtime environment variables.</p>
        </div>
    }
</div>

@code {
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public int ModifiedCount { get; set; }
    [Parameter] public ConnectionStringEntry? ActiveEntry { get; set; }
    [Parameter] public bool IsSaving { get; set; }

    [Parameter] public EventCallback<StructuredBulkUpdateArgs> OnApplyStructured { get; set; }
    [Parameter] public EventCallback<(string find, string replace, bool matchCase)> OnApplyRaw { get; set; }
    [Parameter] public EventCallback OnResetPreview { get; set; }
    [Parameter] public EventCallback OnSaveAllClicked { get; set; }
    [Parameter] public EventCallback<ConnectionStringEntry> OnInspectModal { get; set; }

    private ConfigCategory ActiveCategory { get; set; } = ConfigCategory.ConnectionStrings;
    private string EditMode { get; set; } = "structured"; // "structured" | "raw"

    private StructuredBulkUpdateArgs StructuredArgs { get; set; } = new();
    private bool ShowPassword { get; set; } = false;

    private string RawFindText { get; set; } = string.Empty;
    private string RawReplaceWith { get; set; } = string.Empty;
    private bool MatchCase { get; set; } = false;

    private string EndpointOnlyFind { get; set; } = string.Empty;
    private string EndpointOnlyReplace { get; set; } = string.Empty;
    private string EndpointOnlyDirectUrl { get; set; } = string.Empty;
    private string EndpointOnlyTargetName { get; set; } = string.Empty;

    private bool IsStructuredEmpty =>
        string.IsNullOrWhiteSpace(StructuredArgs.Server) &&
        string.IsNullOrWhiteSpace(StructuredArgs.Database) &&
        string.IsNullOrWhiteSpace(StructuredArgs.UserId) &&
        string.IsNullOrWhiteSpace(StructuredArgs.Password) &&
        (!StructuredArgs.UpdateEndpoints || (
            string.IsNullOrWhiteSpace(StructuredArgs.EndpointFindPattern) &&
            string.IsNullOrWhiteSpace(StructuredArgs.EndpointReplacePattern) &&
            string.IsNullOrWhiteSpace(StructuredArgs.EndpointNewAddress)));

    private async Task ApplyStructuredToSelected()
    {
        if (IsStructuredEmpty) return;
        await OnApplyStructured.InvokeAsync(StructuredArgs);
    }

    private void ClearStructuredFields()
    {
        StructuredArgs = new StructuredBulkUpdateArgs();
    }

    private async Task ApplyRawToSelected()
    {
        if (string.IsNullOrEmpty(RawFindText)) return;
        await OnApplyRaw.InvokeAsync((RawFindText, RawReplaceWith, MatchCase));
    }

    private async Task ApplyEndpointOnly()
    {
        if (string.IsNullOrWhiteSpace(EndpointOnlyFind) && string.IsNullOrWhiteSpace(EndpointOnlyDirectUrl)) return;
        var args = new StructuredBulkUpdateArgs
        {
            UpdateEndpoints = true,
            EndpointFindPattern = EndpointOnlyFind,
            EndpointReplacePattern = EndpointOnlyReplace,
            EndpointNewAddress = EndpointOnlyDirectUrl,
            TargetEndpointName = EndpointOnlyTargetName
        };
        await OnApplyStructured.InvokeAsync(args);
    }

    private void ClearEndpointOnly()
    {
        EndpointOnlyFind = string.Empty;
        EndpointOnlyReplace = string.Empty;
        EndpointOnlyDirectUrl = string.Empty;
        EndpointOnlyTargetName = string.Empty;
    }
}
