@namespace ConfigManager.Components.Shared
@using ConfigManager.Models

<div class="settings-panel">
    <!-- Category Tabs Navigation -->
    <div class="category-header">
        <div class="category-tabs">
            <button class="cat-tab @(ActiveCategory == ConfigCategory.ConnectionStrings ? "active" : "")"
                    @onclick="() => ActiveCategory = ConfigCategory.ConnectionStrings">
                <span>Connection Strings</span>
            </button>
            <button class="cat-tab @(ActiveCategory == ConfigCategory.ClientEndpoints ? "active" : "")"
                    @onclick="() => ActiveCategory = ConfigCategory.ClientEndpoints">
                <span>Client Endpoints</span>
            </button>
            <button class="cat-tab @(ActiveCategory == ConfigCategory.AppSettings ? "active" : "")"
                    @onclick="() => ActiveCategory = ConfigCategory.AppSettings">
                <span>App Settings</span>
                <span class="cat-pill-badge">Soon</span>
            </button>
            <button class="cat-tab @(ActiveCategory == ConfigCategory.EnvironmentVariables ? "active" : "")"
                    @onclick="() => ActiveCategory = ConfigCategory.EnvironmentVariables">
                <span>Env Vars</span>
                <span class="cat-pill-badge">Soon</span>
            </button>
        </div>
    </div>

    <!-- Category Content -->
    @if (ActiveCategory == ConfigCategory.ConnectionStrings)
    {
        <div class="panel-scroll-content">
            <!-- Mode Switcher: Structured Parameters vs Raw Find/Replace -->
            <div class="submode-segment">
                <button class="segment-btn @(EditMode == "structured" ? "active" : "")"
                        @onclick='() => EditMode = "structured"'>
                    Parameters (Host, DB, User)
                </button>
                <button class="segment-btn @(EditMode == "raw" ? "active" : "")"
                        @onclick='() => EditMode = "raw"'>
                    Raw Find &amp; Replace
                </button>
            </div>

            @if (EditMode == "structured")
            {
                <!-- Structured Fields Form -->
                <div class="structured-form-box">
                    <div class="form-section-title">
                        <span>Bulk Parameter Overrides</span>
                        <span class="field-hint">Blank fields remain untouched</span>
                    </div>

                    <div class="param-field">
                        <label class="param-label">
                            <span class="param-name">Host / Server</span>
                            <span class="param-alias">Data Source / Server / Host</span>
                        </label>
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="e.g. 192.168.1.50 or NEW-SRV-02"
                               @bind="StructuredArgs.Server" />
                    </div>

                    <div class="param-field">
                        <label class="param-label">
                            <span class="param-name">Database</span>
                            <span class="param-alias">Initial Catalog / Database</span>
                        </label>
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="e.g. SalesDatabase_Prod"
                               @bind="StructuredArgs.Database" />
                    </div>

                    <div class="param-field">
                        <label class="param-label">
                            <span class="param-name">Username</span>
                            <span class="param-alias">User ID / Username / Uid</span>
                        </label>
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="e.g. sa or app_db_user"
                               @bind="StructuredArgs.UserId" />
                    </div>

                    <div class="param-field">
                        <label class="param-label">
                            <span class="param-name">Password</span>
                            <span class="param-alias">Password / Pwd</span>
                        </label>
                        <div class="input-password-wrap">
                            <input type="@(ShowPassword ? "text" : "password")"
                                   class="form-control form-control-sm"
                                   placeholder="Enter new password..."
                                   @bind="StructuredArgs.Password" />
                            <button type="button" class="btn-toggle-eye" @onclick="() => ShowPassword = !ShowPassword" title="Show/Hide">
                                @(ShowPassword ? "Hide" : "Show")
                            </button>
                        </div>
                    </div>

                    <!-- Optional Client Endpoints Update Section -->
                    <div class="endpoint-optional-box">
                        <div class="endpoint-toggle-row">
                            <label class="checkbox-label-compact" title="Check to also update Client / WCF endpoint addresses">
                                <input type="checkbox" @bind="StructuredArgs.UpdateEndpoints" />
                                <span class="endpoint-toggle-title">Update Client Endpoints (Optional)</span>
                            </label>
                            <span class="endpoint-tag">WCF / SSO</span>
                        </div>

                        @if (StructuredArgs.UpdateEndpoints)
                        {
                            <div class="endpoint-subform">
                                <div class="param-field">
                                    <label class="param-label">
                                        <span class="param-name">Find in Endpoint URL</span>
                                        <span class="param-alias">Host, IP, or substring to replace</span>
                                    </label>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="e.g. localhost or 192.168.43.164"
                                           @bind="StructuredArgs.EndpointFindPattern" />
                                </div>

                                <div class="param-field">
                                    <label class="param-label">
                                        <span class="param-name">Replace with</span>
                                        <span class="param-alias">New Host, IP, or domain</span>
                                    </label>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="e.g. 192.168.26.21"
                                           @bind="StructuredArgs.EndpointReplacePattern" />
                                </div>

                                <div class="param-field">
                                    <label class="param-label">
                                        <span class="param-name">Specific Full URL (Optional)</span>
                                        <span class="param-alias">Direct override for SSOSoap or target</span>
                                    </label>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="e.g. http://192.168.26.21/VICTOR/SSO/Service/SSO.asmx"
                                           @bind="StructuredArgs.EndpointNewAddress" />
                                </div>

                                <div class="param-field">
                                    <label class="param-label">
                                        <span class="param-name">Target Endpoint Name (Optional)</span>
                                        <span class="param-alias">Leave blank to apply to all endpoints</span>
                                    </label>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="e.g. SSOSoap (or blank for all)"
                                           @bind="StructuredArgs.TargetEndpointName" />
                                </div>
                            </div>
                        }
                    </div>

                    <div class="param-actions-row">
                        <button class="btn btn-primary btn-sm flex-1"
                                @onclick="ApplyStructuredToSelected"
                                disabled="@(IsStructuredEmpty || SelectedCount == 0)">
                            Apply to @SelectedCount Selected
                        </button>

                        <button class="btn btn-outline btn-sm"
                                @onclick="ClearStructuredFields"
                                title="Clear input fields">
                            Clear
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Raw Find & Replace Form -->
                <div class="structured-form-box">
                    <div class="form-section-title">
                        <span>Global String Find &amp; Replace</span>
                    </div>

                    <div class="param-field">
                        <label class="param-label">Find Text</label>
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Exact string to find..."
                               @bind="RawFindText" />
                    </div>

                    <div class="param-field">
                        <label class="param-label">Replace With</label>
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Replacement string..."
                               @bind="RawReplaceWith" />
                    </div>

                    <div class="param-field">
                        <label class="checkbox-label-compact">
                            <input type="checkbox" @bind="MatchCase" />
                            <span>Match Case (Exact case-sensitive)</span>
                        </label>
                    </div>

                    <div class="param-actions-row">
                        <button class="btn btn-primary btn-sm flex-1"
                                @onclick="ApplyRawToSelected"
                                disabled="@(string.IsNullOrEmpty(RawFindText) || SelectedCount == 0)">
                            Apply Preview to @SelectedCount Selected
                        </button>
                    </div>
                </div>
            }

            <!-- Live Active Entry Inspector -->
            <div class="inspector-card">
                <div class="inspector-title">Active Row Inspector</div>
                @if (ActiveEntry == null)
                {
                    <div class="inspector-empty">Click any row in the table to inspect details</div>
                }
                else
                {
                    <div class="inspector-field">
                        <span class="insp-label">Category:</span>
                        <span class="insp-val">@(ActiveEntry.Category == ConfigCategory.ClientEndpoints ? "Client / Service Endpoint" : "Connection String")</span>
                    </div>
                    <div class="inspector-field">
                        <span class="insp-label">File:</span>
                        <span class="insp-val">@ActiveEntry.FileName</span>
                    </div>
                    <div class="inspector-field">
                        <span class="insp-label">Key:</span>
                        <span class="insp-val text-primary-high">@ActiveEntry.KeyName</span>
                    </div>
                    <div class="inspector-field">
                        <span class="insp-label">Type:</span>
                        <span class="insp-val">@(ActiveEntry.FileType == ConfigFileType.WebConfig ? "web.config (XML)" : "appsettings.json")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(ActiveEntry.ProviderName))
                    {
                        <div class="inspector-field">
                            <span class="insp-label">Provider/Binding:</span>
                            <span class="insp-val text-mono-xs">@ActiveEntry.ProviderName</span>
                        </div>
                    }

                    @if (ActiveEntry.Category == ConfigCategory.ConnectionStrings)
                    {
                        var parsed = ConnectionStringHelper.Parse(ActiveEntry.CurrentValue);
                        <div class="inspector-params-grid">
                            <div class="insp-param-item">
                                <span class="insp-p-name">Host / Server:</span>
                                <span class="insp-p-val">@(parsed.Server ?? "-")</span>
                            </div>
                            <div class="insp-param-item">
                                <span class="insp-p-name">Database:</span>
                                <span class="insp-p-val">@(parsed.Database ?? "-")</span>
                            </div>
                            <div class="insp-param-item">
                                <span class="insp-p-name">Username:</span>
                                <span class="insp-p-val">@(parsed.UserId ?? "-")</span>
                            </div>
                            <div class="insp-param-item">
                                <span class="insp-p-name">Password:</span>
                                <span class="insp-p-val">@(string.IsNullOrEmpty(parsed.Password) ? "-" : "••••••••")</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="inspector-field">
                            <span class="insp-label">Current Address:</span>
                            <span class="insp-val text-mono-xs" title="@ActiveEntry.CurrentValue">@ActiveEntry.CurrentValue</span>
                        </div>
                    }

                    <div class="inspector-actions">
                        <button class="btn btn-outline btn-xs flex-1"
                                @onclick="() => OnInspectModal.InvokeAsync(ActiveEntry)">
                            Open Full Diff
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Sticky Save Dock -->
        <div class="save-dock">
            <div class="save-dock-info">
                <span>Pending saves:</span>
                <span class="save-dock-count @(ModifiedCount > 0 ? "text-amber" : "")">@ModifiedCount</span>
            </div>
            <button class="btn btn-save btn-sm flex-1"
                    @onclick="() => OnSaveAllClicked.InvokeAsync()"
                    disabled="@(ModifiedCount == 0 || IsSaving)">
                @if (IsSaving)
                {
                    <span class="spinner-small"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save All Changes (@ModifiedCount)</span>
                }
            </button>
        </div>
    }
    else if (ActiveCategory == ConfigCategory.ClientEndpoints)
    {
        <div class="panel-scroll-content">
            <div class="structured-form-box">
                <div class="form-section-title">
                    <span>WCF &amp; Service Endpoints</span>
                    <span class="field-hint">e.g. SSO.asmx, wsTransaction.asmx</span>
                </div>

                <div class="param-field">
                    <label class="param-label">
                        <span class="param-name">Target / Match in URL</span>
                        <span class="param-alias">Host, IP, or old server to replace</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="e.g. localhost or 192.168.43.164"
                           @bind="EndpointOnlyFind" />
                </div>

                <div class="param-field">
                    <label class="param-label">
                        <span class="param-name">Replace with</span>
                        <span class="param-alias">New Server IP, Host, or Domain</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="e.g. 192.168.26.21"
                           @bind="EndpointOnlyReplace" />
                </div>

                <div class="param-field">
                    <label class="param-label">
                        <span class="param-name">Specific Full URL (Optional)</span>
                        <span class="param-alias">Direct override for target endpoint</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="e.g. http://192.168.26.21/VICTOR/SSO/Service/SSO.asmx"
                           @bind="EndpointOnlyDirectUrl" />
                </div>

                <div class="param-field">
                    <label class="param-label">
                        <span class="param-name">Target Endpoint Name (Optional)</span>
                        <span class="param-alias">Filter specific endpoint name (e.g. SSOSoap)</span>
                    </label>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="e.g. SSOSoap (or blank for all)"
                           @bind="EndpointOnlyTargetName" />
                </div>

                <div class="param-actions-row">
                    <button class="btn btn-primary btn-sm flex-1"
                            @onclick="ApplyEndpointOnly"
                            disabled="@((string.IsNullOrWhiteSpace(EndpointOnlyFind) && string.IsNullOrWhiteSpace(EndpointOnlyDirectUrl)) || SelectedCount == 0)">
                        Apply to @SelectedCount Selected
                    </button>
                    <button class="btn btn-outline btn-sm"
                            @onclick="ClearEndpointOnly">
                        Clear
                    </button>
                </div>
            </div>

            <!-- Active Inspector if selected entry is an endpoint -->
            @if (ActiveEntry != null)
            {
                <div class="inspector-card">
                    <div class="inspector-title">Selected Item Inspector</div>
                    <div class="inspector-field">
                        <span class="insp-label">Category:</span>
                        <span class="insp-val">@(ActiveEntry.Category == ConfigCategory.ClientEndpoints ? "Client / Service Endpoint" : "Connection String")</span>
                    </div>
                    <div class="inspector-field">
                        <span class="insp-label">Name:</span>
                        <span class="insp-val">@ActiveEntry.KeyName</span>
                    </div>
                    @if (!string.IsNullOrEmpty(ActiveEntry.ProviderName))
                    {
                        <div class="inspector-field">
                            <span class="insp-label">Binding/Contract:</span>
                            <span class="insp-val text-mono-xs">@ActiveEntry.ProviderName</span>
                        </div>
                    }
                    <div class="inspector-field">
                        <span class="insp-label">Current Address:</span>
                        <span class="insp-val text-mono-xs" title="@ActiveEntry.CurrentValue">@ActiveEntry.CurrentValue</span>
                    </div>
                    @if (ActiveEntry.HasChanges)
                    {
                        <div class="inspector-field">
                            <span class="insp-label">New Preview:</span>
                            <span class="insp-val text-mono-xs text-amber" title="@ActiveEntry.NewValue">@ActiveEntry.NewValue</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sticky Save Dock -->
        <div class="save-dock">
            <div class="save-dock-info">
                <span>Pending saves:</span>
                <span class="save-dock-count @(ModifiedCount > 0 ? "text-amber" : "")">@ModifiedCount</span>
            </div>
            <button class="btn btn-save btn-sm flex-1"
                    @onclick="() => OnSaveAllClicked.InvokeAsync()"
                    disabled="@(ModifiedCount == 0 || IsSaving)">
                @if (IsSaving)
                {
                    <span class="spinner-small"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save All Changes (@ModifiedCount)</span>
                }
            </button>
        </div>
    }
    else if (ActiveCategory == ConfigCategory.AppSettings)
    {
        <div class="panel-scroll-content empty-category">
            <div class="empty-icon-sm">⚙️</div>
            <h4>App Settings Category</h4>
            <p>Future modular category for key-value application settings, feature flags, and custom JSON nodes.</p>
        </div>
    }
    else
    {
        <div class="panel-scroll-content empty-category">
            <div class="empty-icon-sm">🌐</div>
            <h4>Environment Variables Category</h4>
            <p>Future modular category for container and runtime environment variable configurations.</p>
        </div>
    }
</div>

@code {
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public int ModifiedCount { get; set; }
    [Parameter] public ConnectionStringEntry? ActiveEntry { get; set; }
    [Parameter] public bool IsSaving { get; set; }

    [Parameter] public EventCallback<StructuredBulkUpdateArgs> OnApplyStructured { get; set; }
    [Parameter] public EventCallback<(string find, string replace, bool matchCase)> OnApplyRaw { get; set; }
    [Parameter] public EventCallback OnResetPreview { get; set; }
    [Parameter] public EventCallback OnSaveAllClicked { get; set; }
    [Parameter] public EventCallback<ConnectionStringEntry> OnInspectModal { get; set; }

    private ConfigCategory ActiveCategory { get; set; } = ConfigCategory.ConnectionStrings;
    private string EditMode { get; set; } = "structured"; // "structured" | "raw"

    private StructuredBulkUpdateArgs StructuredArgs { get; set; } = new();
    private bool ShowPassword { get; set; } = false;

    private string RawFindText { get; set; } = string.Empty;
    private string RawReplaceWith { get; set; } = string.Empty;
    private bool MatchCase { get; set; } = false;

    private string EndpointOnlyFind { get; set; } = string.Empty;
    private string EndpointOnlyReplace { get; set; } = string.Empty;
    private string EndpointOnlyDirectUrl { get; set; } = string.Empty;
    private string EndpointOnlyTargetName { get; set; } = string.Empty;

    private bool IsStructuredEmpty =>
        string.IsNullOrWhiteSpace(StructuredArgs.Server) &&
        string.IsNullOrWhiteSpace(StructuredArgs.Database) &&
        string.IsNullOrWhiteSpace(StructuredArgs.UserId) &&
        string.IsNullOrWhiteSpace(StructuredArgs.Password) &&
        (!StructuredArgs.UpdateEndpoints || (
            string.IsNullOrWhiteSpace(StructuredArgs.EndpointFindPattern) &&
            string.IsNullOrWhiteSpace(StructuredArgs.EndpointReplacePattern) &&
            string.IsNullOrWhiteSpace(StructuredArgs.EndpointNewAddress)));

    private async Task ApplyStructuredToSelected()
    {
        if (IsStructuredEmpty) return;
        await OnApplyStructured.InvokeAsync(StructuredArgs);
    }

    private void ClearStructuredFields()
    {
        StructuredArgs = new StructuredBulkUpdateArgs();
    }

    private async Task ApplyRawToSelected()
    {
        if (string.IsNullOrEmpty(RawFindText)) return;
        await OnApplyRaw.InvokeAsync((RawFindText, RawReplaceWith, MatchCase));
    }

    private async Task ApplyEndpointOnly()
    {
        if (string.IsNullOrWhiteSpace(EndpointOnlyFind) && string.IsNullOrWhiteSpace(EndpointOnlyDirectUrl)) return;
        var args = new StructuredBulkUpdateArgs
        {
            UpdateEndpoints = true,
            EndpointFindPattern = EndpointOnlyFind,
            EndpointReplacePattern = EndpointOnlyReplace,
            EndpointNewAddress = EndpointOnlyDirectUrl,
            TargetEndpointName = EndpointOnlyTargetName
        };
        await OnApplyStructured.InvokeAsync(args);
    }

    private void ClearEndpointOnly()
    {
        EndpointOnlyFind = string.Empty;
        EndpointOnlyReplace = string.Empty;
        EndpointOnlyDirectUrl = string.Empty;
        EndpointOnlyTargetName = string.Empty;
    }
}
