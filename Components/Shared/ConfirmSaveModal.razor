@namespace ConfigManager.Components.Shared
@using ConfigManager.Models

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleCancel">
        <div class="modal-container save-confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <div class="modal-icon-save">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>
                        </svg>
                    </div>
                    <div>
                        <h3 class="modal-title">Confirm Save Changes</h3>
                        <p class="modal-subtitle">Review files that will be overwritten with new connection strings.</p>
                    </div>
                </div>
                <button class="btn-close" @onclick="HandleCancel" title="Close" disabled="@IsSaving">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <div class="save-stats-banner">
                    <div class="stat-box">
                        <div class="stat-number">@Details.TotalFiles</div>
                        <div class="stat-label">File(s) to Update</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-number highlight">@Details.TotalEntries</div>
                        <div class="stat-label">Connection String(s)</div>
                    </div>
                </div>

                <div class="backup-alert-box">
                    <div class="backup-alert-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <div class="backup-alert-text">
                        <strong>Automatic Backup Active</strong>
                        <p>Each file will be automatically backed up in its original directory as <code>[filename].bak_YYYYMMDDHHMMSS</code> before any edits are written.</p>
                    </div>
                </div>

                <div class="file-list-preview">
                    <div class="file-list-header">Files to be modified:</div>
                    <div class="file-list-scroll">
                        @foreach (var group in Details.EntriesToSave.GroupBy(e => e.FilePath))
                        {
                            var filePath = group.Key;
                            var fileName = System.IO.Path.GetFileName(filePath);
                            var isXml = group.First().FileType == ConfigFileType.WebConfig;

                            <div class="file-preview-item">
                                <div class="file-preview-top">
                                    <span class="file-type-pill @(isXml ? "pill-xml" : "pill-json")">
                                        @(isXml ? "XML" : "JSON")
                                    </span>
                                    <strong class="file-name">@fileName</strong>
                                    <span class="file-dir text-muted">@System.IO.Path.GetDirectoryName(filePath)</span>
                                </div>
                                <div class="file-preview-keys">
                                    <span class="keys-label">Keys:</span>
                                    @foreach (var entry in group)
                                    {
                                        <span class="key-tag">@entry.KeyName</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="HandleCancel" disabled="@IsSaving">
                    Cancel
                </button>
                <button class="btn btn-success" @onclick="HandleConfirm" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span class="spinner-small"></span>
                        <span>Writing to disk...</span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Yes, Backup &amp; Save All Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public SaveConfirmationDetails Details { get; set; } = new();
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnConfirmSave { get; set; }

    private async Task HandleCancel()
    {
        if (IsSaving) return;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleConfirm()
    {
        await OnConfirmSave.InvokeAsync();
    }
}
