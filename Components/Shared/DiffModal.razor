@namespace ConfigManager.Components.Shared
@using ConfigManager.Models
@inject IJSRuntime JS

@if (IsOpen && Entry != null)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-container diff-modal-card" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="modal-title-group">
                    <div class="modal-badges-row">
                        <span class="type-pill @(Entry.FileType == ConfigFileType.WebConfig ? "type-xml" : "type-json")">
                            @(Entry.FileType == ConfigFileType.WebConfig ? "XML web.config" : "JSON appsettings")
                        </span>
                        @if (Entry.Category == ConfigCategory.ClientEndpoints)
                        {
                            <span class="badge-type-endpoint">
                                <span class="badge-type-dot dot-purple"></span>
                                Endpoint
                            </span>
                        }
                        else
                        {
                            <span class="badge-type-db">
                                <span class="badge-type-dot dot-blue"></span>
                                DB Connection
                            </span>
                        }
                    </div>
                    <h3 class="modal-title">Inspect &amp; Compare: @Entry.KeyName</h3>
                </div>
                <button class="btn-close-modal" @onclick="Close" title="Close modal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body diff-modal-body">
                <!-- File Path Pill -->
                <div class="modal-filepath-pill">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                    <span class="filepath-text mono" title="@Entry.FilePath">@Entry.FilePath</span>
                    <button class="btn-copy-mini @(CopiedKey == "path" ? "copied" : "")"
                            @onclick='() => CopyToClipboard(Entry.FilePath, "path")'
                            title="Copy File Path">
                        @if (CopiedKey == "path")
                        {
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Copied!</span>
                        }
                        else
                        {
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                            <span>Copy</span>
                        }
                    </button>
                </div>

                <!-- Compare Panels: BEFORE vs AFTER -->
                <div class="compare-panels-grid">
                    <!-- Original / Current Panel -->
                    <div class="compare-card">
                        <div class="compare-card-header">
                            <span class="compare-label-text">ORIGINAL (ON DISK)</span>
                            <button class="btn-copy-mini @(CopiedKey == "orig" ? "copied" : "")"
                                    @onclick='() => CopyToClipboard(Entry.CurrentValue, "orig")'
                                    title="Copy Original Value">
                                @if (CopiedKey == "orig")
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Copied!</span>
                                }
                                else
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                    </svg>
                                    <span>Copy</span>
                                }
                            </button>
                        </div>
                        <div class="compare-code-box original-box mono">
                            @Entry.CurrentValue
                        </div>
                    </div>

                    <!-- New Preview / Editable Panel -->
                    <div class="compare-card">
                        <div class="compare-card-header">
                            <div class="compare-header-left">
                                <span class="compare-label-text label-preview">PREVIEW NEW VALUE</span>
                                @if (IsModified)
                                {
                                    <span class="diff-amber-dot animate-pulse"></span>
                                    <span class="compare-status-text">Modified</span>
                                }
                            </div>
                            <button class="btn-copy-mini @(CopiedKey == "prev" ? "copied" : "")"
                                    @onclick='() => CopyToClipboard(EditedValue, "prev")'
                                    title="Copy Preview Value">
                                @if (CopiedKey == "prev")
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>Copied!</span>
                                }
                                else
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                    </svg>
                                    <span>Copy</span>
                                }
                            </button>
                        </div>
                        <textarea class="compare-textarea mono @(IsModified ? "textarea-modified" : "")"
                                  rows="4"
                                  placeholder="Enter new connection string or endpoint..."
                                  @bind="EditedValue"
                                  @bind:event="oninput"></textarea>
                    </div>
                </div>

                <!-- Parsed Parameters Breakdown Table -->
                @if (ParsedParameters.Count > 0)
                {
                    <div class="params-breakdown-section">
                        <div class="params-header-row">
                            <span class="params-section-title">PARSED PARAMETERS BREAKDOWN</span>
                            <span class="params-changed-summary">
                                @ParsedParameters.Count(p => p.IsDifferent) of @ParsedParameters.Count parameter(s) modified
                            </span>
                        </div>

                        <div class="params-table-container">
                            <table class="params-breakdown-table">
                                <thead>
                                    <tr>
                                        <th class="th-param-name">Parameter</th>
                                        <th class="th-param-orig">Original Value</th>
                                        <th class="th-param-prev">Preview Value</th>
                                        <th class="th-param-stat">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var param in ParsedParameters)
                                    {
                                        <tr class="@(param.IsDifferent ? "tr-param-modified" : "")">
                                            <td class="td-param-name">
                                                <span class="param-key-text">@param.Key</span>
                                            </td>
                                            <td class="td-param-orig mono">
                                                <span class="param-orig-val">@param.OriginalValue</span>
                                            </td>
                                            <td class="td-param-prev mono">
                                                @if (param.IsDifferent)
                                                {
                                                    <mark class="diff-token-highlight">@param.PreviewValue</mark>
                                                }
                                                else
                                                {
                                                    <span class="param-same-val">@param.PreviewValue</span>
                                                }
                                            </td>
                                            <td class="td-param-stat">
                                                @if (param.IsDifferent)
                                                {
                                                    <span class="badge badge-modified">
                                                        <span class="badge-dot dot-modified animate-pulse"></span>
                                                        Changed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-unchanged">
                                                        <span class="badge-dot dot-unchanged"></span>
                                                        Same
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="params-breakdown-section">
                        <div class="params-header-row">
                            <span class="params-section-title">CONFIGURATION BREAKDOWN</span>
                        </div>
                        <div class="params-empty-notice">
                            Single-value configuration (no key=value parameters detected). Compare directly in the preview boxes above.
                        </div>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer diff-modal-footer">
                <div class="footer-left-actions">
                    @if (IsModified)
                    {
                        <button class="btn-pill-subtle text-amber" @onclick="Revert" title="Revert to original value">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"></polyline>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                            </svg>
                            <span>Revert to Original</span>
                        </button>
                    }
                </div>

                <div class="footer-right-actions">
                    <button class="btn-pill-subtle" @onclick="Close">
                        Close
                    </button>
                    <button class="btn-pill-dark" @onclick="SaveEdit" disabled="@(!IsModified)">
                        <span>Update Preview</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ConnectionStringEntry? Entry { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<ConnectionStringEntry> OnSaved { get; set; }

    private string EditedValue { get; set; } = string.Empty;
    private string? CopiedKey { get; set; }

    private bool IsModified =>
        Entry != null && !string.Equals(Entry.CurrentValue, EditedValue, StringComparison.Ordinal);

    protected override void OnParametersSet()
    {
        if (Entry != null)
        {
            EditedValue = Entry.NewValue;
        }
    }

    private class ParamDiff
    {
        public string Key { get; set; } = string.Empty;
        public string OriginalValue { get; set; } = string.Empty;
        public string PreviewValue { get; set; } = string.Empty;
        public bool IsDifferent => !string.Equals(OriginalValue, PreviewValue, StringComparison.Ordinal);
    }

    private List<ParamDiff> ParsedParameters
    {
        get
        {
            if (Entry == null) return new();
            var orig = ParseParams(Entry.CurrentValue);
            var prev = ParseParams(EditedValue);

            var allKeys = orig.Keys.Union(prev.Keys, StringComparer.OrdinalIgnoreCase).ToList();
            var list = new List<ParamDiff>();

            foreach (var k in allKeys)
            {
                orig.TryGetValue(k, out var origVal);
                prev.TryGetValue(k, out var prevVal);
                list.Add(new ParamDiff
                {
                    Key = k,
                    OriginalValue = origVal ?? "(not set)",
                    PreviewValue = prevVal ?? "(not set)"
                });
            }

            return list;
        }
    }

    private Dictionary<string, string> ParseParams(string connStr)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(connStr)) return dict;

        // URL / Endpoint detection
        if (Uri.TryCreate(connStr.Trim(), UriKind.Absolute, out var uri) &&
            (uri.Scheme.StartsWith("http", StringComparison.OrdinalIgnoreCase) || uri.Scheme.StartsWith("net.", StringComparison.OrdinalIgnoreCase)))
        {
            dict["Scheme"] = uri.Scheme;
            dict["Host / Server"] = uri.Host;
            dict["Port"] = uri.Port > 0 ? uri.Port.ToString() : "(default)";
            dict["Path"] = uri.AbsolutePath;
            if (!string.IsNullOrEmpty(uri.Query)) dict["Query"] = uri.Query;
            return dict;
        }

        var parts = connStr.Split(';', StringSplitOptions.RemoveEmptyEntries);
        foreach (var p in parts)
        {
            var eqIdx = p.IndexOf('=');
            if (eqIdx > 0)
            {
                var k = p.Substring(0, eqIdx).Trim();
                var v = p.Substring(eqIdx + 1).Trim();
                dict[k] = v; // Uses indexer for duplicate safety
            }
        }
        return dict;
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private void Revert()
    {
        if (Entry != null)
        {
            EditedValue = Entry.CurrentValue;
        }
    }

    private async Task SaveEdit()
    {
        if (Entry != null)
        {
            Entry.ApplyPreview(EditedValue);
            await OnSaved.InvokeAsync(Entry);
            await Close();
        }
    }

    private async Task CopyToClipboard(string text, string key)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            CopiedKey = key;
            StateHasChanged();
            _ = Task.Delay(1400).ContinueWith(_ =>
            {
                CopiedKey = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch { }
    }
}
